<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============ LIST ============ -->
        <record id="view_ka_giling_monitoring_sbh_list" model="ir.ui.view">
            <field name="name">ka.giling.monitoring.sbh.list</field>
            <field name="model">ka.giling.monitoring.sbh</field>
            <field name="arch" type="xml">
                <list string="Monitoring SBH" create="false" edit="false" delete="false"
                      decoration-success="labarugi_rp &gt; 0"
                      decoration-danger="labarugi_rp &lt; 0">
                    <field name="date"/>
                    <field name="periode_code" optional="show"/>
                    <field name="tebu_sbh" sum="Tebu SBH"/>
                    <field name="rend_sbh" optional="show"/>
                    <field name="prod_gula" sum="Produksi Gula" optional="show"/>
                    <field name="gula_milik_pg" sum="Gula Milik PG" optional="hide"/>
                    <field name="pendapatan" optional="show"/>
                    <field name="biaya_produksi" optional="hide"/>
                    <field name="laba_biaya_rp" sum="Laba thd Biaya Produksi" optional="show"/>
                    <field name="labarugi_rp" sum="Laba/Rugi Total"/>
                    <field name="status" widget="badge"
                           decoration-success="status == 'laba'"
                           decoration-danger="status == 'rugi'"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- ============ GRAPH ============ -->
        <record id="view_ka_giling_monitoring_sbh_graph" model="ir.ui.view">
            <field name="name">ka.giling.monitoring.sbh.graph</field>
            <field name="model">ka.giling.monitoring.sbh</field>
            <field name="arch" type="xml">
                <graph string="Monitoring SBH" type="line" sample="1">
                    <field name="date" interval="day"/>
                    <field name="labarugi_rp" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- ============ PIVOT ============ -->
        <record id="view_ka_giling_monitoring_sbh_pivot" model="ir.ui.view">
            <field name="name">ka.giling.monitoring.sbh.pivot</field>
            <field name="model">ka.giling.monitoring.sbh</field>
            <field name="arch" type="xml">
                <pivot string="Monitoring SBH" sample="1">
                    <field name="periode_code" type="row"/>
                    <field name="tebu_sbh" type="measure"/>
                    <field name="prod_gula" type="measure"/>
                    <field name="labarugi_rp" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- ============ SEARCH ============ -->
        <record id="view_ka_giling_monitoring_sbh_search" model="ir.ui.view">
            <field name="name">ka.giling.monitoring.sbh.search</field>
            <field name="model">ka.giling.monitoring.sbh</field>
            <field name="arch" type="xml">
                <search string="Cari Monitoring SBH">
                    <field name="date"/>
                    <field name="periode_id"/>
                    <filter name="filter_laba" string="Laba" domain="[('status', '=', 'laba')]"/>
                    <filter name="filter_rugi" string="Rugi" domain="[('status', '=', 'rugi')]"/>
                    <group expand="0" string="Kelompokkan">
                        <filter name="group_periode" string="Periode" context="{'group_by': 'periode_id'}"/>
                        <filter name="group_bulan" string="Bulan" context="{'group_by': 'date:month'}"/>
                        <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ============ ACTION ============ -->
        <record id="action_ka_giling_monitoring_sbh" model="ir.actions.act_window">
            <field name="name">Monitoring SBH</field>
            <field name="res_model">ka.giling.monitoring.sbh</field>
            <field name="view_mode">list,graph,pivot</field>
            <field name="search_view_id" ref="view_ka_giling_monitoring_sbh_search"/>
            <field name="context">{'search_default_group_periode': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Belum ada data Monitoring SBH</p>
                <p>Data muncul otomatis dari Laporan Harian Giling yang memiliki tebu SBH (TR-SBH + TS).</p>
            </field>
        </record>

    </data>
</odoo>
