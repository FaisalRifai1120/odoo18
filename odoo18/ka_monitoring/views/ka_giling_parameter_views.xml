<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============ LIST ============ -->
        <record id="view_ka_giling_parameter_list" model="ir.ui.view">
            <field name="name">ka.giling.parameter.list</field>
            <field name="model">ka.giling.parameter</field>
            <field name="arch" type="xml">
                <list string="Parameter">
                    <field name="name"/>
                    <field name="faktor_gula"/>
                    <field name="fr"/>
                    <field name="wr"/>
                    <field name="company_id" groups="base.group_multi_company" optional="show"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- ============ FORM ============ -->
        <record id="view_ka_giling_parameter_form" model="ir.ui.view">
            <field name="name">ka.giling.parameter.form</field>
            <field name="model">ka.giling.parameter</field>
            <field name="arch" type="xml">
                <form string="Parameter">
                    <sheet>
                        <widget name="web_ribbon" title="Arsip" bg_color="text-bg-danger"
                                invisible="active"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Parameter Default"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Konstanta Proses">
                                <field name="faktor_gula"/>
                                <field name="fr"/>
                                <field name="wr"/>
                            </group>
                            <group string="Tetes">
                                <field name="brix_tetes_puteran"/>
                                <field name="kristal_tetes_standar"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <p class="text-muted">
                            Konstanta ini dipakai pada perhitungan rendemen &amp; produksi gula di Monitoring (Fase berikutnya).
                            Faktor Gula umumnya 1.003, FR 0.7, WR 0.97.
                        </p>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ============ ACTION ============ -->
        <record id="action_ka_giling_parameter" model="ir.actions.act_window">
            <field name="name">Parameter</field>
            <field name="res_model">ka.giling.parameter</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Buat Set Parameter</p>
                <p>Konstanta proses giling: Faktor Gula, FR, WR, dll.</p>
            </field>
        </record>

    </data>
</odoo>
