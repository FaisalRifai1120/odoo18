<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="rule_ka_cetak_ngp_batch_company" model="ir.rule">
            <field name="name">Batch NGP: aturan multi-company</field>
            <field name="model_id" ref="model_ka_cetak_ngp_batch"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_ka_cetak_ngp_line_company" model="ir.rule">
            <field name="name">Baris NGP: aturan multi-company</field>
            <field name="model_id" ref="model_ka_cetak_ngp_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
