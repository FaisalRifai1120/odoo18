<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ka_cetak.PrintProgress">
        <div class="o_ka_cetak_progress d-flex flex-column align-items-center justify-content-center p-5">

            <t t-if="!state.error">
                <div class="mb-3 text-center">
                    <i t-if="!state.finished" class="fa fa-spinner fa-spin fa-3x text-primary"/>
                    <i t-else="" class="fa fa-check-circle fa-3x text-success"/>
                </div>

                <h4 class="text-center mb-1" t-if="!state.finished and !state.merging">
                    Sedang menyiapkan cetakan NGP...
                </h4>
                <h4 class="text-center mb-1" t-if="state.merging">
                    Menggabungkan file PDF...
                </h4>
                <h4 class="text-center text-success mb-1" t-if="state.finished">
                    Selesai! File sedang diunduh.
                </h4>

                <div class="progress my-3" style="width: 380px; height: 24px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                         role="progressbar"
                         t-att-style="'width:' + percent + '%'"
                         t-esc="percent + '%'"/>
                </div>

                <p class="text-muted mb-3">
                    <t t-esc="state.done"/> / <t t-esc="state.total"/> NGP
                </p>

                <div t-if="state.finished">
                    <button class="btn btn-secondary" t-on-click="close">Tutup</button>
                </div>
                <p t-else="" class="small text-muted text-center" style="max-width:380px;">
                    Mohon jangan menutup jendela ini sampai proses selesai.
                </p>
            </t>

            <t t-else="">
                <div class="text-center">
                    <i class="fa fa-exclamation-triangle fa-3x text-warning mb-3"/>
                    <h4>Terjadi kesalahan saat memproses cetakan.</h4>
                    <p class="text-muted">Silakan coba lagi, atau kurangi jumlah baris yang dicetak.</p>
                    <button class="btn btn-secondary mt-2" t-on-click="close">Tutup</button>
                </div>
            </t>

        </div>
    </t>

</templates>
