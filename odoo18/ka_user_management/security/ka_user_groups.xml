<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_ka" model="ir.module.category">
            <field name="name">KA Modules</field>
            <field name="description">Grup akses untuk seluruh modul KA</field>
            <field name="sequence">100</field>
        </record>

        <!-- Grup TANPA implied_ids agar record rules tidak saling override -->
        <record id="group_ka_ppl" model="res.groups">
            <field name="name">PPL (Penyuluh Pertanian Lapangan)</field>
            <field name="category_id" ref="module_category_ka"/>
        </record>

        <record id="group_ka_kasubsi" model="res.groups">
            <field name="name">KASUBSI (Kepala Sub Seksi)</field>
            <field name="category_id" ref="module_category_ka"/>
        </record>

        <record id="group_ka_kasi" model="res.groups">
            <field name="name">KASI (Kepala Seksi)</field>
            <field name="category_id" ref="module_category_ka"/>
        </record>

        <record id="group_ka_kabag" model="res.groups">
            <field name="name">KABAG (Kepala Bagian)</field>
            <field name="category_id" ref="module_category_ka"/>
        </record>

        <record id="group_ka_pimpinan" model="res.groups">
            <field name="name">Pemimpin Pabrik</field>
            <field name="category_id" ref="module_category_ka"/>
        </record>

        <record id="group_ka_operator" model="res.groups">
            <field name="name">Operator</field>
            <field name="category_id" ref="module_category_ka"/>
        </record>

        <record id="group_ka_admin" model="res.groups">
            <field name="name">Administrator KA</field>
            <field name="category_id" ref="module_category_ka"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
