<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- PPL: hanya lihat timbangan register milik sendiri -->
        <record id="rule_ka_timbang_tebu_ppl" model="ir.rule">
            <field name="name">Timbang Tebu: PPL hanya lihat milik sendiri</field>
            <field name="model_id" ref="model_ka_timbang_tebu"/>
            <field name="groups" eval="[(4, ref('ka_user_management.group_ka_ppl'))]"/>
            <field name="domain_force">[('register_id.ppl_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- KASUBSI: lihat timbangan PPL bawahannya -->
        <record id="rule_ka_timbang_tebu_kasubsi" model="ir.rule">
            <field name="name">Timbang Tebu: KASUBSI lihat hierarki bawahan</field>
            <field name="model_id" ref="model_ka_timbang_tebu"/>
            <field name="groups" eval="[(4, ref('ka_user_management.group_ka_kasubsi'))]"/>
            <field name="domain_force">[('register_id.ppl_id.atasan_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- KASI: lihat timbangan PPL bawahan KASUBSInya -->
        <record id="rule_ka_timbang_tebu_kasi" model="ir.rule">
            <field name="name">Timbang Tebu: KASI lihat hierarki bawahan</field>
            <field name="model_id" ref="model_ka_timbang_tebu"/>
            <field name="groups" eval="[(4, ref('ka_user_management.group_ka_kasi'))]"/>
            <field name="domain_force">[('register_id.ppl_id.atasan_id.atasan_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- KABAG: lihat semua hierarki bawahnya -->
        <record id="rule_ka_timbang_tebu_kabag" model="ir.rule">
            <field name="name">Timbang Tebu: KABAG lihat hierarki bawahan</field>
            <field name="model_id" ref="model_ka_timbang_tebu"/>
            <field name="groups" eval="[(4, ref('ka_user_management.group_ka_kabag'))]"/>
            <field name="domain_force">[('register_id.ppl_id.atasan_id.atasan_id.atasan_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Pemimpin Pabrik: lihat semua -->
        <record id="rule_ka_timbang_tebu_pimpinan" model="ir.rule">
            <field name="name">Timbang Tebu: Pemimpin Pabrik lihat semua</field>
            <field name="model_id" ref="model_ka_timbang_tebu"/>
            <field name="groups" eval="[(4, ref('ka_user_management.group_ka_pimpinan'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Operator: akses semua (create/edit) -->
        <record id="rule_ka_timbang_tebu_operator" model="ir.rule">
            <field name="name">Timbang Tebu: Operator akses semua</field>
            <field name="model_id" ref="model_ka_timbang_tebu"/>
            <field name="groups" eval="[(4, ref('ka_user_management.group_ka_operator'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Administrator: akses penuh -->
        <record id="rule_ka_timbang_tebu_admin" model="ir.rule">
            <field name="name">Timbang Tebu: Administrator akses penuh</field>
            <field name="model_id" ref="model_ka_timbang_tebu"/>
            <field name="groups" eval="[(4, ref('ka_user_management.group_ka_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
