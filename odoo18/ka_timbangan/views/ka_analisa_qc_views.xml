<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════
         ANALISA QC LIST
    ══════════════════════════════ -->
    <record id="view_ka_analisa_qc_list" model="ir.ui.view">
        <field name="name">ka.analisa.qc.list</field>
        <field name="model">ka.analisa.qc</field>
        <field name="arch" type="xml">
            <list string="Analisa QC" create="false" edit="false" delete="false">
                <field name="no_spta" string="No. SPTA"/>
                <field name="kd_antrian" string="No. Antrian"/>
                <field name="timbang_id" string="Data Timbang" optional="show"/>
                <field name="varietas_brix" string="Varietas" optional="show"/>
                <field name="brix_core" string="Brix Core" digits="[10,4]"/>
                <field name="pol_core" string="Pol Core" digits="[10,4]"/>
                <field name="rend_core" string="Rend. Core" digits="[10,4]" optional="show"/>
                <field name="brix_ari" string="Brix Ari" digits="[10,4]" optional="show"/>
                <field name="pol_ari" string="Pol Ari" digits="[10,4]" optional="show"/>
                <field name="rend_ari" string="Rend. Ari" digits="[10,4]" optional="show"/>
                <field name="rend_npp" string="Rend. NPP" digits="[10,4]"/>
                <field name="rend_perjam" string="Rend./Jam" digits="[10,4]" optional="show"/>
                <field name="rend_harian" string="Rend. Harian" digits="[10,4]" optional="show"/>
                <field name="created_at" string="Tgl. Analisa"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════
         ANALISA QC FORM
    ══════════════════════════════ -->
    <record id="view_ka_analisa_qc_form" model="ir.ui.view">
        <field name="name">ka.analisa.qc.form</field>
        <field name="model">ka.analisa.qc</field>
        <field name="arch" type="xml">
            <form string="Analisa QC">
                <sheet>
                    <div class="oe_title">
                        <label for="no_spta" string="No. SPTA"/>
                        <h1><field name="no_spta" readonly="1"/></h1>
                        <h3 class="text-muted">
                            <field name="kd_antrian" readonly="1"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Identitas">
                            <field name="no_spta" readonly="1"/>
                            <field name="kd_antrian" readonly="1"/>
                            <field name="timbang_id" readonly="1"/>
                            <field name="varietas_brix" readonly="1"/>
                            <field name="pos_brix" readonly="1"/>
                        </group>
                        <group string="Timestamp">
                            <field name="created_at" readonly="1"/>
                            <field name="updated_at" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Core">
                            <field name="brix_core" readonly="1"/>
                            <field name="pol_core" readonly="1"/>
                            <field name="rend_core" readonly="1"/>
                        </group>
                        <group string="Ari">
                            <field name="brix_ari" readonly="1"/>
                            <field name="pol_ari" readonly="1"/>
                            <field name="rend_ari" readonly="1"/>
                        </group>
                    </group>
                    <group string="Rendemen">
                        <group>
                            <field name="rend_npp" readonly="1"/>
                            <field name="rend_perjam" readonly="1"/>
                        </group>
                        <group>
                            <field name="rend_harian" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════
         ANALISA QC SEARCH
    ══════════════════════════════ -->
    <record id="view_ka_analisa_qc_search" model="ir.ui.view">
        <field name="name">ka.analisa.qc.search</field>
        <field name="model">ka.analisa.qc</field>
        <field name="arch" type="xml">
            <search string="Cari Analisa QC">
                <field name="no_spta" string="No. SPTA"/>
                <field name="kd_antrian" string="No. Antrian"/>
                <field name="timbang_id" string="Data Timbang"/>
                <filter name="filter_tahun_ini" string="Tahun Ini"
                        domain="[('created_at','&gt;=', datetime.date(context_today().year, 1, 1).strftime('%Y-%m-%d')), ('created_at','&lt;', datetime.date(context_today().year + 1, 1, 1).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_tahun_lalu" string="Tahun Kemarin"
                        domain="[('created_at','&gt;=', datetime.date(context_today().year - 1, 1, 1).strftime('%Y-%m-%d')), ('created_at','&lt;', datetime.date(context_today().year, 1, 1).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_linked" string="Terhubung ke Timbang"
                        domain="[('timbang_id','!=', False)]"/>
                <filter name="filter_not_linked" string="Belum Terhubung"
                        domain="[('timbang_id','=', False)]"/>
                <group expand="0" string="Kelompokkan">
                    <filter name="group_date" string="Tgl. Analisa"
                            context="{'group_by': 'created_at:day'}"/>
                    <filter name="group_timbang" string="Data Timbang"
                            context="{'group_by': 'timbang_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ka_analisa_qc" model="ir.actions.act_window">
        <field name="name">Analisa QC</field>
        <field name="res_model">ka.analisa.qc</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ka_analisa_qc_search"/>
        <field name="context">{'search_default_filter_tahun_ini': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada data analisa QC!</p>
            <p>Data akan otomatis tersinkronisasi dari database PostgreSQL.</p>
        </field>
    </record>

    <!-- ══════════════════════════════
         SYNC ANALISA QC
    ══════════════════════════════ -->
    <record id="view_ka_analisa_qc_sync_form" model="ir.ui.view">
        <field name="name">ka.analisa.qc.sync.form</field>
        <field name="model">ka.analisa.qc.sync</field>
        <field name="arch" type="xml">
            <form string="Sinkronisasi Analisa QC">
                <header>
                    <button name="action_sync_manual"
                            string="Sync Manual (Rentang Tanggal)"
                            type="object" class="btn-primary"
                            confirm="Sync analisa QC sesuai rentang tanggal. Lanjutkan?"
                            invisible="not date_from or not date_to"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Koneksi">
                            <field name="company_id"/>
                            <field name="sync_config_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Status (Cron: data tahun ini)">
                            <field name="last_sync" readonly="1"/>
                            <field name="last_sync_status" readonly="1"
                                   decoration-success="last_sync_status == 'success'"
                                   decoration-danger="last_sync_status == 'failed'"/>
                            <field name="total_synced" readonly="1"/>
                        </group>
                    </group>
                    <group string="Filter Sync Manual">
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group string="Pesan Terakhir" invisible="not last_sync_message">
                        <field name="last_sync_message" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ka_analisa_qc_sync_list" model="ir.ui.view">
        <field name="name">ka.analisa.qc.sync.list</field>
        <field name="model">ka.analisa.qc.sync</field>
        <field name="arch" type="xml">
            <list string="Sinkronisasi Analisa QC">
                <field name="company_id" string="Unit"/>
                <field name="name"/>
                <field name="sync_config_id"/>
                <field name="last_sync"/>
                <field name="last_sync_status"
                       decoration-success="last_sync_status == 'success'"
                       decoration-danger="last_sync_status == 'failed'"/>
                <field name="total_synced"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_ka_analisa_qc_sync" model="ir.actions.act_window">
        <field name="name">Sinkronisasi Analisa QC</field>
        <field name="res_model">ka.analisa.qc.sync</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
