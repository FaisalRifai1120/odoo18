<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron timbang: sekaligus menjalankan QC sync secara sequential -->
        <record id="cron_ka_sync_tebu" model="ir.cron">
            <field name="name">KA Timbangan: Sinkronisasi Tebu Otomatis</field>
            <field name="model_id" ref="model_ka_timbang_sync"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_tebu()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- Cron QC dinonaktifkan — sudah dijalankan sequential oleh cron timbang -->
        <record id="cron_ka_sync_analisa_qc" model="ir.cron">
            <field name="name">KA Timbangan: Sinkronisasi Analisa QC Otomatis</field>
            <field name="model_id" ref="model_ka_analisa_qc_sync"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_analisa_qc()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">False</field>
        </record>

    </data>
</odoo>
