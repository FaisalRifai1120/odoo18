<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- PPL: hanya read -->
        <record id="rule_register_ppl" model="ir.rule">
            <field name="name">Register: PPL read only</field>
            <field name="model_id" ref="model_ka_sita_register"/>
            <field name="groups" eval="[(4, ref('ka_user_management.group_ka_ppl'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
