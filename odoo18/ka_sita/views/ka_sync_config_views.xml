<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ka_sync_config_form" model="ir.ui.view">
        <field name="name">ka.sync.config.form</field>
        <field name="model">ka.sync.config</field>
        <field name="arch" type="xml">
            <form string="Konfigurasi Sinkronisasi">
                <header>
                    <button name="action_test_connection"
                            string="Test Koneksi"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_sync_manual"
                            string="Sync Manual (10 Terbaru)"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_sync_all"
                            string="Sync Semua"
                            type="object"
                            class="btn-warning"
                            confirm="Proses ini akan mensinkronisasi semua register. Lanjutkan?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nama Konfigurasi..."/></h1>
                    </div>

                    <group>
                        <group string="Koneksi Database">
                            <field name="db_host" placeholder="192.168.1.x"/>
                            <field name="db_port"/>
                            <field name="db_name" placeholder="nama_database"/>
                            <field name="db_user" placeholder="postgres"/>
                            <field name="db_password" password="True"/>
                            <field name="active"/>
                        </group>
                        <group string="Status Sinkronisasi">
                            <field name="last_sync" readonly="1"/>
                            <field name="last_sync_status" readonly="1"/>
                            <field name="total_synced" readonly="1"/>
                        </group>
                    </group>

                    <group string="Pesan Terakhir"
                           invisible="not last_sync_message">
                        <field name="last_sync_message" nolabel="1" readonly="1"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ka_sync_config_list" model="ir.ui.view">
        <field name="name">ka.sync.config.list</field>
        <field name="model">ka.sync.config</field>
        <field name="arch" type="xml">
            <list string="Konfigurasi Sinkronisasi">
                <field name="name"/>
                <field name="db_host"/>
                <field name="db_port"/>
                <field name="db_name"/>
                <field name="last_sync"/>
                <field name="last_sync_status"
                       decoration-success="last_sync_status == 'success'"
                       decoration-danger="last_sync_status == 'failed'"/>
                <field name="total_synced"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_ka_sync_config" model="ir.actions.act_window">
        <field name="name">Konfigurasi Sinkronisasi</field>
        <field name="res_model">ka.sync.config</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
