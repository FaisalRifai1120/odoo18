<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ka_ketentuan_form" model="ir.ui.view">
        <field name="name">ka.ketentuan.form</field>
        <field name="model">ka.ketentuan</field>
        <field name="arch" type="xml">
            <form string="Ketentuan">
                <header>
                    <button name="action_import_bagihasil" string="Import Bagi Hasil"
                            type="object" class="btn-primary"
                            invisible="state != 'active' or not upload_file"/>
                    <button name="action_import_kawalan" string="Import Kawalan"
                            type="object" class="btn-primary"
                            invisible="state != 'active' or not upload_kawalan_file"/>
                    <button name="action_cancel" string="Batalkan"
                            type="object" class="btn-danger"
                            invisible="state != 'active'"
                            confirm="Batalkan ketentuan ini? Record tetap tersimpan untuk history."/>
                    <button name="action_set_active" string="Aktifkan Kembali"
                            type="object"
                            invisible="state != 'cancel'"
                            groups="ka_user_management.group_ka_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="No. Ketentuan"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Periode">
                            <field name="company_id" readonly="state != 'active'"/>
                            <field name="tanggal" readonly="state != 'active'"/>
                            <field name="tgl_berlaku" readonly="state != 'active'"/>
                        </group>
                        <group string="Bagi Hasil">
                            <field name="bagi_hasil_default" readonly="state != 'active'"/>
                            <field name="line_count" readonly="1"/>
                            <field name="gula_kawalan_default" readonly="state != 'active'"/>
                            <field name="kawalan_count" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Harga">
                            <field name="harga_gula" readonly="state != 'active'"/>
                            <field name="harga_tetes" readonly="state != 'active'"/>
                        </group>
                        <group string="Faktor Rendemen">
                            <field name="faktor_gula" readonly="state != 'active'"/>
                            <field name="faktor_tetes" readonly="state != 'active'"/>
                            <field name="faktor_bh_tetes" readonly="state != 'active'"/>
                            <field name="faktor_nira" readonly="state != 'active'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Pembagian Gula BH (Jual : Natura)">
                            <field name="persen_lelang" readonly="state != 'active'"/>
                            <field name="persen_natura" readonly="state != 'active'"/>
                        </group>
                        <group string="Tetes (Natura3)">
                            <field name="titipan_tetes" readonly="state != 'active'"/>
                        </group>
                    </group>
                    <group string="Keterangan">
                        <field name="keterangan" nolabel="1" readonly="state != 'active'"/>
                    </group>
                    <notebook>
                        <page string="Bagi Hasil per Register">
                            <group string="Upload Excel (kolom: register, bagihasil)"
                                   invisible="state != 'active'">
                                <field name="upload_file" filename="upload_filename"/>
                                <field name="upload_filename" invisible="1"/>
                                <div class="text-muted">
                                    Format: baris 1 = judul (register, bagihasil), data mulai baris 2.
                                    Setelah pilih file, klik tombol <strong>Import Bagi Hasil</strong> di atas.
                                </div>
                            </group>
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="register"/>
                                    <field name="bagi_hasil"/>
                                </list>
                            </field>
                        </page>
                        <page string="Register Kawalan">
                            <group string="Upload Excel (kolom: register)"
                                   invisible="state != 'active'">
                                <field name="upload_kawalan_file" filename="upload_kawalan_filename"/>
                                <field name="upload_kawalan_filename" invisible="1"/>
                                <div class="text-muted">
                                    Format: baris 1 = judul (register), data mulai baris 2.
                                    Hanya 1 kolom (kode register). Setelah pilih file, klik tombol
                                    <strong>Import Kawalan</strong> di atas.
                                    Register yang ada di daftar ini akan mendapat gula kawalan
                                    sebesar <strong>Gula Kawalan Default</strong>.
                                </div>
                            </group>
                            <field name="kawalan_line_ids" readonly="1">
                                <list>
                                    <field name="register"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ka_ketentuan_list" model="ir.ui.view">
        <field name="name">ka.ketentuan.list</field>
        <field name="model">ka.ketentuan</field>
        <field name="arch" type="xml">
            <list string="Ketentuan" decoration-muted="state == 'cancel'">
                <field name="company_id" string="Unit" optional="show"/>
                <field name="name"/>
                <field name="tanggal"/>
                <field name="tgl_berlaku"/>
                <field name="harga_gula"/>
                <field name="bagi_hasil_default" string="BH Default"/>
                <field name="gula_kawalan_default" string="Kawalan Default" optional="show"/>
                <field name="line_count" string="Jml Reg"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_ka_ketentuan_search" model="ir.ui.view">
        <field name="name">ka.ketentuan.search</field>
        <field name="model">ka.ketentuan</field>
        <field name="arch" type="xml">
            <search string="Cari Ketentuan">
                <field name="name"/>
                <filter name="filter_active" string="Aktif" domain="[('state','=','active')]"/>
                <filter name="filter_cancel" string="Dibatalkan" domain="[('state','=','cancel')]"/>
                <group expand="0" string="Kelompokkan">
                    <filter name="group_company" string="Unit" context="{'group_by': 'company_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ka_ketentuan" model="ir.actions.act_window">
        <field name="name">Ketentuan</field>
        <field name="res_model">ka.ketentuan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ka_ketentuan_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

</odoo>
