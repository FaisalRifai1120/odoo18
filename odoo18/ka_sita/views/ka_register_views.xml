<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ka_register_form" model="ir.ui.view">
        <field name="name">ka.sita.register.form</field>
        <field name="model">ka.sita.register</field>
        <field name="arch" type="xml">
            <form string="Register SITA">
                <sheet>
                    <div class="oe_title">
                        <label for="nama_register" string="Nama Register"/>
                        <h1><field name="nama_register" placeholder="Nama Register..."/></h1>
                        <h3 class="text-muted">
                            <field name="kode_register" placeholder="Kode Register..."/>
                        </h3>
                    </div>

                    <group>
                        <group string="Klasifikasi">
                            <field name="jenis_register"/>
                            <field name="metode"/>
                            <field name="jenis_pembayaran"/>
                        </group>
                        <group string="Lokasi">
                            <field name="kud_id"/>
                            <field name="desa_id"/>
                            <field name="kecamatan_id" readonly="1"/>
                        </group>
                    </group>

                    <group string="Data Petani">
                        <group>
                            <field name="petani_id" options="{'no_create': True}"/>
                            <field name="account_petani_id" string="Account Petani (Kode - Nama)" options="{'no_create': True}"/>
                            <field name="no_ktp"/>
                        </group>
                        <group>
                            <field name="ppl_id" options="{'no_create': True}"/>
                            <field name="is_transfer" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <group string="Informasi Transfer" invisible="not is_transfer">
                        <group>
                            <field name="no_rekening"/>
                            <field name="nama_rekening"/>
                        </group>
                        <group>
                            <field name="nama_bank"/>
                        </group>
                    </group>

                    <div invisible="not id" style="margin-top: 16px;">
                        <div class="oe_chatter">
                            <field name="message_follower_ids" widget="mail_followers"/>
                            <field name="message_ids" widget="mail_thread"/>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ka_register_list" model="ir.ui.view">
        <field name="name">ka.sita.register.list</field>
        <field name="model">ka.sita.register</field>
        <field name="arch" type="xml">
            <list string="Daftar Register SITA"
                  decoration-info="jenis_register == 'TR'"
                  decoration-success="jenis_register == 'TS'">
                <field name="kode_register"/>
                <field name="nama_register"/>
                <field name="jenis_register"/>
                <field name="metode"/>
                <field name="jenis_pembayaran"/>
                <field name="kud_id"/>
                <field name="desa_id" optional="hide"/>
                <field name="kecamatan_id" optional="hide"/>
                <field name="petani_id"/>
                <field name="ppl_id" optional="show"/>
                <field name="is_transfer" optional="show" widget="boolean_toggle"/>
                <field name="no_rekening" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ka_register_search" model="ir.ui.view">
        <field name="name">ka.sita.register.search</field>
        <field name="model">ka.sita.register</field>
        <field name="arch" type="xml">
            <search string="Cari Register">
                <field name="kode_register" string="Kode"/>
                <field name="nama_register" string="Nama"/>
                <field name="kud_id" string="KUD"/>
                <field name="petani_id" string="Petani"/>
                <field name="ppl_id" string="PPL"/>
                <field name="kecamatan_id" string="Kecamatan"/>
                <field name="desa_id" string="Desa"/>
                <filter name="filter_tr" string="TR" domain="[('jenis_register','=','TR')]"/>
                <filter name="filter_ts" string="TS" domain="[('jenis_register','=','TS')]"/>
                <separator/>
                <filter name="filter_sbh" string="SBH" domain="[('metode','=','SBH')]"/>
                <filter name="filter_spt" string="SPT" domain="[('metode','=','SPT')]"/>
                <separator/>
                <filter name="filter_transfer" string="Transfer" domain="[('is_transfer','=',True)]"/>
                <group expand="0" string="Kelompokkan">
                    <filter name="group_jenis" string="Jenis Register" context="{'group_by': 'jenis_register'}"/>
                    <filter name="group_metode" string="Metode" context="{'group_by': 'metode'}"/>
                    <filter name="group_kud" string="KUD" context="{'group_by': 'kud_id'}"/>
                    <filter name="group_kecamatan" string="Kecamatan" context="{'group_by': 'kecamatan_id'}"/>
                    <filter name="group_petani" string="Petani" context="{'group_by': 'petani_id'}"/>
                    <filter name="group_ppl" string="PPL" context="{'group_by': 'ppl_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ka_register" model="ir.actions.act_window">
        <field name="name">Register</field>
        <field name="res_model">ka.sita.register</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ka_register_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Buat Register SITA Pertama!</p>
            <p>Lengkapi data register: jenis, metode, KUD, wilayah, dan petani.</p>
        </field>
    </record>

</odoo>
