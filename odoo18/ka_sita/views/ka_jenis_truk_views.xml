<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ka_jenis_truk_list" model="ir.ui.view">
        <field name="name">ka.jenis.truk.list</field>
        <field name="model">ka.jenis.truk</field>
        <field name="arch" type="xml">
            <list string="Jenis Truk" editable="bottom">
                <field name="kode"/>
                <field name="nama"/>
                <field name="keterangan" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ka_jenis_truk_form" model="ir.ui.view">
        <field name="name">ka.jenis.truk.form</field>
        <field name="model">ka.jenis.truk</field>
        <field name="arch" type="xml">
            <form string="Jenis Truk">
                <sheet>
                    <group>
                        <group>
                            <field name="kode"/>
                            <field name="nama"/>
                        </group>
                        <group>
                            <field name="keterangan"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ka_jenis_truk" model="ir.actions.act_window">
        <field name="name">Jenis Truk</field>
        <field name="res_model">ka.jenis.truk</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
