<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_ka_kasbank_import_wizard_form" model="ir.ui.view">
            <field name="name">ka.kasbank.import.wizard.form</field>
            <field name="model">ka.kasbank.import.wizard</field>
            <field name="arch" type="xml">
                <form string="Import dari Excel">
                    <!-- DRAFT: form input -->
                    <group invisible="state == 'done'">
                        <div class="alert alert-info" colspan="2" role="alert">
                            <i class="fa fa-info-circle"/> Unggah file Excel sumber, pilih jenis data &amp; unit.
                            Kunci unik dipakai agar import bisa diulang tanpa duplikat
                            (tanggal+unit untuk saldo; tanggal+produk+tahun untuk persediaan;
                            No.SP/No.Invoice untuk penjualan).
                        </div>
                        <group>
                            <field name="import_type"/>
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                            <field name="sheet_name"
                                   placeholder="kosongkan = default per jenis"/>
                        </group>
                        <group>
                            <field name="company_id"
                                   invisible="import_type == 'sales_bulk'"/>
                            <field name="create_missing"/>
                            <field name="update_existing"/>
                        </group>
                    </group>

                    <!-- DONE: ringkasan -->
                    <group invisible="state != 'done'">
                        <div class="alert alert-success" colspan="2" role="alert">
                            <i class="fa fa-check-circle"/> Import selesai.
                        </div>
                        <field name="result_summary" nolabel="1" readonly="1"
                               widget="text"/>
                    </group>

                    <footer>
                        <button name="action_import" type="object" string="Import"
                                class="btn-primary" invisible="state == 'done'"/>
                        <button special="cancel" string="Tutup"
                                class="btn-secondary" invisible="state != 'done'"/>
                        <button special="cancel" string="Batal"
                                class="btn-secondary" invisible="state == 'done'"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_ka_kasbank_import_wizard" model="ir.actions.act_window">
            <field name="name">Import dari Excel</field>
            <field name="res_model">ka.kasbank.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
