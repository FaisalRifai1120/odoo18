<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="rule_ka_kasbank_balance_company" model="ir.rule">
            <field name="name">Saldo Kas/Bank: aturan multi-company</field>
            <field name="model_id" ref="model_ka_kasbank_balance"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_ka_kasbank_balance_line_company" model="ir.rule">
