            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_ka_kasbank_loan_company" model="ir.rule">
            <field name="name">Hutang Bank: aturan multi-company</field>
            <field name="model_id" ref="model_ka_kasbank_loan"/>
