<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============ LIST ============ -->
        <record id="view_ka_kasbank_deposito_list" model="ir.ui.view">
            <field name="name">ka.kasbank.deposito.list</field>
            <field name="model">ka.kasbank.deposito</field>
            <field name="arch" type="xml">
                <list string="Deposito"
                      decoration-muted="state == 'matured'">
                    <field name="bank_id"/>
                    <field name="name" optional="show"/>
                    <field name="amount" sum="Total Deposito"/>
                    <field name="placement_date" optional="show"/>
                    <field name="maturity_date"/>
                    <field name="interest_rate" optional="hide"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'active'"
                           decoration-muted="state == 'matured'"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- ============ FORM ============ -->
        <record id="view_ka_kasbank_deposito_form" model="ir.ui.view">
            <field name="name">ka.kasbank.deposito.form</field>
            <field name="model">ka.kasbank.deposito</field>
            <field name="arch" type="xml">
                <form string="Deposito">
                    <header>
                        <button name="action_set_matured" type="object" string="Tandai Cair"
                                class="btn-primary" invisible="state == 'matured'"/>
                        <button name="action_set_active" type="object" string="Set Aktif"
                                invisible="state == 'active'"/>
                        <field name="state" widget="statusbar" statusbar_visible="active,matured"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="bank_id" string="Bank"/>
                            <h1><field name="bank_id" placeholder="Pilih bank..."/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="amount"/>
                                <field name="interest_rate"/>
                            </group>
                            <group>
                                <field name="placement_date"/>
                                <field name="maturity_date"/>
                                <field name="currency_id" groups="base.group_multi_currency"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <field name="note" placeholder="Catatan..."/>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ============ SEARCH ============ -->
        <record id="view_ka_kasbank_deposito_search" model="ir.ui.view">
            <field name="name">ka.kasbank.deposito.search</field>
            <field name="model">ka.kasbank.deposito</field>
            <field name="arch" type="xml">
                <search string="Cari Deposito">
                    <field name="bank_id"/>
                    <field name="name"/>
                    <filter name="filter_active" string="Aktif" domain="[('state', '=', 'active')]"/>
                    <filter name="filter_matured" string="Cair" domain="[('state', '=', 'matured')]"/>
                    <group expand="0" string="Kelompokkan">
                        <filter name="group_bank" string="Bank" context="{'group_by': 'bank_id'}"/>
                        <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ============ ACTION ============ -->
        <record id="action_ka_kasbank_deposito" model="ir.actions.act_window">
            <field name="name">Deposito</field>
            <field name="res_model">ka.kasbank.deposito</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_ka_kasbank_deposito_search"/>
            <field name="context">{'search_default_filter_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Catat deposito pertama</p>
                <p>Deposito berjangka per bank, lengkap dengan tanggal pencairan &amp; statusnya.</p>
            </field>
        </record>

    </data>
</odoo>
