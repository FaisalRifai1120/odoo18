<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============ LIST ============ -->
        <record id="view_ka_kasbank_account_list" model="ir.ui.view">
            <field name="name">ka.kasbank.account.list</field>
            <field name="model">ka.kasbank.account</field>
            <field name="arch" type="xml">
                <list string="Akun Kas/Bank">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code" optional="hide"/>
                    <field name="account_type"/>
                    <field name="account_number"/>
                    <field name="bank_id" optional="show"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                    <field name="active" widget="boolean_toggle" optional="show"/>
                </list>
            </field>
        </record>

        <!-- ============ FORM ============ -->
        <record id="view_ka_kasbank_account_form" model="ir.ui.view">
            <field name="name">ka.kasbank.account.form</field>
            <field name="model">ka.kasbank.account</field>
            <field name="arch" type="xml">
                <form string="Akun Kas/Bank">
                    <sheet>
                        <widget name="web_ribbon" title="Arsip" bg_color="text-bg-danger"
                                invisible="active"/>
                        <div class="oe_title">
                            <label for="name" string="Nama Akun"/>
                            <h1><field name="name" placeholder="mis. Bank Mandiri Tab Bisnis"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="account_type"/>
                                <field name="account_number"/>
                                <field name="bank_id"
                                       invisible="account_type == 'cash'"/>
                            </group>
                            <group>
                                <field name="code"/>
                                <field name="currency_id" groups="base.group_multi_currency"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="active" invisible="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="note" placeholder="Keterangan tambahan..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============ SEARCH ============ -->
        <record id="view_ka_kasbank_account_search" model="ir.ui.view">
            <field name="name">ka.kasbank.account.search</field>
            <field name="model">ka.kasbank.account</field>
            <field name="arch" type="xml">
                <search string="Cari Akun">
                    <field name="name"/>
                    <field name="account_number"/>
                    <field name="bank_id"/>
                    <filter name="filter_cash" string="Kas" domain="[('account_type', '=', 'cash')]"/>
                    <filter name="filter_bank" string="Bank" domain="[('account_type', '=', 'bank')]"/>
                    <separator/>
                    <filter name="filter_archived" string="Diarsip" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Kelompokkan">
                        <filter name="group_type" string="Tipe" context="{'group_by': 'account_type'}"/>
                        <filter name="group_bank" string="Bank" context="{'group_by': 'bank_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ============ ACTION ============ -->
        <record id="action_ka_kasbank_account" model="ir.actions.act_window">
            <field name="name">Akun Kas/Bank</field>
            <field name="res_model">ka.kasbank.account</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_ka_kasbank_account_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Tambahkan akun Kas/Bank pertama</p>
                <p>Daftar rekening (Kas, Mandiri, BNI, UOB, dst) yang menjadi kolom
                   pada pencatatan saldo harian.</p>
            </field>
        </record>

    </data>
</odoo>
