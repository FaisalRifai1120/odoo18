    <menuitem id="menu_ka_kecamatan"
              name="Kecamatan"
              parent="menu_ka_wilayah"
              action="action_ka_kecamatan"
              sequence="30"/>

    <menuitem id="menu_ka_desa"
              name="Desa / Kelurahan"
              parent="menu_ka_wilayah"
              action="action_ka_desa"
              sequence="40"/>

    <!-- KUD -->
    <menuitem id="menu_ka_kud"
              name="KUD"
              parent="menu_ka_tanaman_master"
              action="action_ka_kud"
              sequence="20"/>

    <!-- Petani -->
    <menuitem id="menu_ka_petani"
              name="Petani"
              parent="menu_ka_tanaman_master"
              action="action_ka_petani"
