              name="KA Tanaman"
              sequence="10"
              web_icon="ka_tanaman,static/description/icon.png"
              groups="ka_user_management.group_ka_operator,ka_user_management.group_ka_admin"/>

    <!-- Master Data -->
    <menuitem id="menu_ka_tanaman_master"
              name="Master Data"
              parent="menu_ka_tanaman_root"
